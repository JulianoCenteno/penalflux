{
  "cleanUrls": true,
  "trailingSlash": true,
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://ltzynrrjmrwqnrcjulcj.supabase.co/functions/v1/pf/:path*" }
  ],
  "redirects": [
    { "source": "/app/bumps/:file*", "destination": "/app/#conteudos", "permanent": false }
